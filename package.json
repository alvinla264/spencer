{
  "name": "spencer-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/protocol",
    "packages/relay",
    "packages/spencer",
    "packages/web"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 'packages/*/test/**/*.test.ts' 'packages/web/test/**/*.test.js'",
    "test:unit": "node --test 'packages/protocol/test/**/*.test.ts' 'packages/relay/test/**/*.test.ts'",
    "test:integration": "node --test --test-concurrency=1 'packages/*/test/integration/**/*.test.ts'",
    "build:relay": "node scripts/build-relay.mjs",
    "start": "node packages/spencer/src/main.ts",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "7.0.2"
  }
}
